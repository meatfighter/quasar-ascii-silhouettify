    "dev": "quasar dev",
    "build": "quasar build",
    "run": "http-server ./dist/spa"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "chroma-js": "^2.4.2",
    "pinia": "^2.1.7",
